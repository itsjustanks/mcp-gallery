{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/itsjustanks/mcp-gallery/main/schema/gallery-meta.schema.json",
  "title": "Curation metadata stored under _meta[\"io.github.itsjustanks/mcp-gallery\"]",
  "type": "object",
  "additionalProperties": false,
  "required": ["displayName", "category", "auth", "docsUrl", "verifiedAt"],
  "properties": {
    "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
    "category": {
      "type": "string",
      "enum": [
        "ai",
        "automation",
        "crm",
        "database",
        "developer",
        "documentation",
        "observability",
        "payments",
        "productivity",
        "support",
        "websites"
      ]
    },
    "iconUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "auth": { "type": "string", "enum": ["oauth", "token", "none"] },
    "docsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "verifiedAt": { "type": "string", "format": "date" }
  }
}
